@model SistemaAutoStock.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Entrar no Sistema";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">

                <form asp-controller="Account" asp-action="Login" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="UserName" class="control-label fw-bold"></label>
                        <input asp-for="UserName" class="form-control" placeholder="Digite seu usuário" />
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Password" class="control-label fw-bold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Digite sua senha" />
                    </div>

                    <div class="form-group d-grid">
                        <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                    </div>

                </form>
            </div>
            <div class="card-footer text-center">
                <a asp-action="Register">Ainda não tem uma conta? Crie aqui.</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
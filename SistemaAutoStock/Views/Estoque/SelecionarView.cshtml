@using System.Data
@model DataTable
@using SistemaAutoStock.ViewModels
@{
    ViewData["Title"] = "Estoque";
    Layout = "../Shared/_LayoutPROF.cshtml";
}

<div class="container-fluid py-4" id="Container-Estoque">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">

        <div class="w-100 mb-3 mb-md-0">
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-box-seam me-2 text-primary"></i> Controle de Estoque</h2>
            <p class="text-muted small mb-0">Gerencie e acompanhe os níveis de peças automotivas</p>
        </div>

        <div class="acoes-topo-container d-flex flex-wrap gap-2 w-100 justify-content-md-end">
            <button type="button" class="btn btn-outline-danger border-2 fw-bold px-3 flex-grow-1 flex-md-grow-0" data-bs-toggle="modal" data-bs-target="#modalAvisos" style="border-radius: 10px;">
                <i class="bi bi-exclamation-triangle"></i> Avisos
            </button>
            <button type="button" class="btn btn-primary fw-bold px-4 shadow-sm flex-grow-1 flex-md-grow-0" data-bs-toggle="modal" data-bs-target="#modalNovo" style="border-radius: 10px;">
                <i class="bi bi-plus-lg"></i> Novo Item
            </button>
        </div>

    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm d-flex align-items-center mb-4 d-flex align-items-center justify-content-between mb-4" role="alert" style="border-radius: 12px;">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>&ensp; @TempData["MsgSucesso"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" id="close-btn" aria-label="Close">X</button>
        </div>
    }

    <div class="filter-section mb-4">
        <div class="row g-4">
            <div class="col-12 col-lg-5">
                <label class="form-label-custom label-filtro"><i class="bi bi-search"></i> PESQUISAR ITEM</label>
                <div class="input-group-modern d-flex align-items-center">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="inputBusca" class="form-control" placeholder="Buscar por nome, ID ou material...">
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label-custom label-filtro"><i class="bi bi-funnel"></i> STATUS</label>
                <div class="input-group-modern d-flex align-items-center">
                    <span class="input-group-text"><i class="bi bi-info-circle"></i></span>
                    <select id="filtroStatus" class="form-select">
                        <option value="">Todos os Status</option>
                        <option value="Disponível">Disponível</option>
                        <option value="Em Uso">Em Uso</option>
                        <option value="Manutenção">Manutenção</option>
                    </select>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-4">
                <label class="form-label-custom label-filtro"><i class="bi bi-bar-chart"></i> NÍVEL DE ESTOQUE</label>
                <div class="input-group-modern d-flex align-items-center">
                    <span class="input-group-text"><i class="bi bi-reception-4"></i></span>
                    <select id="filtroQtd" class="form-select">
                        <option value="">Todas as Quantidades</option>
                        <option value="baixa">Crítico (até 5 un)</option>
                        <option value="media">Moderado (6 a 10 un)</option>
                        <option value="alta">Saudável (acima de 10 un)</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="Table-Estoque">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold">ID</th>
                        <th class="py-3 text-uppercase small fw-bold">Nome da Peça</th>
                        <th class="py-3 text-uppercase small fw-bold">Quantidade</th>
                        <th class="py-3 text-uppercase small fw-bold">Status</th>
                        <th class="py-3 text-uppercase small fw-bold">Material</th>
                        <th class="py-3 text-uppercase small fw-bold">Peso</th>
                        <th class="py-3 text-uppercase small fw-bold">Valor</th>
                        <th class="py-3 text-uppercase small fw-bold">Tipo</th>
                        <th class="text-center pe-4 py-3 text-uppercase small fw-bold">Ações</th>
                    </tr>
                </thead>
                <tbody id="tbodyEstoque">
                    @foreach (DataRow row in Model.Rows)
                    {
                        <tr>
                            <td class="fw-bold text-secondary ps-4">#@row["id_peca"]</td>
                            <td class="fw-semibold text-dark">@row["nome_peca"]</td>
                            <td>
                                @{
                                    int qtd = Convert.ToInt32(row["quantidade"]);
                                }
                                <span class="badge rounded-pill px-3 py-2 @(qtd <= 5 ? "badge-critico" : qtd <= 10 ? "badge-moderado" : "badge-sucesso")">
                                    @qtd un
                                </span>
                            </td>
                            <td>
                                @{
                                    string status = row["status"].ToString();
                                    string statusClass = status == "Disponível" ? "text-success bg-success-subtle" :
                                    status == "Em Uso" ? "text-primary bg-primary-subtle" : "text-danger bg-danger-subtle";
                                }
                                <span class="badge @statusClass border px-2.5 py-1.5 fw-semibold rounded-2 text-xs">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 6px; vertical-align: middle;"></i> @status
                                </span>
                            </td>
                            <td class="text-secondary text-sm">@row["material"]</td>
                            <td class="text-secondary text-sm">@row["peso"] kg</td>
                            <td class="fw-semibold text-dark">@Convert.ToDecimal(row["valor"]).ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                            <td><span class="text-muted bg-light px-2 py-1 rounded text-xs">@row["tipo"]</span></td>
                            <td class="text-center pe-4">
                                <div class="d-flex justify-content-center gap-2">
                                    <button class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#edit-@row["id_peca"]" style="border-radius: 8px; margin: 4px;">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#del-@row["id_peca"]" style="border-radius: 8px; margin: 4px;">
                                        <i class="bi bi-trash3 text-danger"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap px-2">
        <div class="text-muted small fw-bold" id="infoPaginacao">
            Mostrando 0 de 0 itens
        </div>
        <nav>
            <ul class="pagination mb-0" id="paginacaoUl"></ul>
        </nav>
    </div>
</div>

@foreach (DataRow row in Model.Rows)
{
    <div class="modal fade" id="edit-@row["id_peca"]" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-controller="Estoque" asp-action="editar" method="post" class="modal-content shadow-lg border-0 rounded-4">
                <div class="modal-header bg-primary text-white border-0 py-3">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi bi-pencil-square me-2"></i> Editar Peça #@row["id_peca"]
                    </h5>
                    <button type="button" class="btn-close btn-close-white" id="close-btn" data-bs-dismiss="modal">X</button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="IdPeca" value="@row["id_peca"]" />
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary">Nome da Peça</label>
                        <input type="text" name="NomePeca" value="@row["nome_peca"]" class="form-control" required style="border-radius: 10px;">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Quantidade</label>
                            <input type="number" name="Quantidade" value="@row["quantidade"]" class="form-control" required style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Status</label>
                            <select name="Status" class="form-select" style="border-radius: 10px;">
                                <option value="Disponível" selected='@(row["status"].ToString() == "Disponível")'>Disponível</option>
                                <option value="Em Uso" selected='@(row["status"].ToString() == "Em Uso")'>Em Uso</option>
                                <option value="Manutenção" selected='@(row["status"].ToString() == "Manutenção")'>Manutenção</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Material</label>
                            <input type="text" name="Material" value="@row["material"]" class="form-control" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Tipo/Categoria</label>
                            <input type="text" name="Tipo" value="@row["tipo"]" class="form-control" style="border-radius: 10px;">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Peso (kg)</label>
                            <input type="number" step="0.01" name="Peso" value="@Convert.ToDecimal(row["peso"]).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" style="border-radius: 10px;">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold text-secondary">Valor (R$)</label>
                            <input type="number" step="0.01" name="Valor" value="@Convert.ToDecimal(row["valor"]).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" style="border-radius: 10px;">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius: 10px;">Cancelar</button>
                    <button type="submit" class="btn btn-save fw-bold px-4 shadow-sm">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="del-@row["id_peca"]" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <form asp-controller="Estoque" asp-action="excluir" method="post" class="modal-content border-0 shadow-lg rounded-4">
                <input type="hidden" name="IdPeca" value="@row["id_peca"]" />
                <div class="modal-body text-center pt-5 pb-4">
                    <div class="text-danger mb-3"><i class="bi bi-exclamation-octagon-fill" style="font-size: 3.5rem;"></i></div>
                    <h5 class="fw-bold text-dark mb-2">Excluir Peça?</h5>
                    <p class="text-muted small px-2">Deseja apagar permanentemente <br><strong class="text-dark">"@row["nome_peca"]"</strong>?</p>
                </div>
                <div class="modal-footer justify-content-center border-0 bg-transparent pb-4 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal" style="border-radius: 8px;">Voltar</button>
                    <button type="submit" class="btn btn-danger btn-sm px-4 fw-bold shadow-sm" style="border-radius: 8px;">Sim, Excluir</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="modal fade" id="modalNovo" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Estoque" asp-action="InserirProcessar" method="post" class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header bg-primary text-white py-3 border-0">
                <h5 class="modal-title fw-bold d-flex align-items-center">
                    <i class="bi bi-plus-circle-fill me-2"></i> Nova Peça Automotiva
                </h5>
                <button type="button" class="btn-close btn-close-white" id="close-btn" data-bs-dismiss="modal">X</button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary">Nome do Item</label>
                    <input type="text" name="NomePeca" class="form-control" placeholder="Ex: Kit Amortecedor Dianteiro" required style="border-radius: 10px;">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary">Qtd. Inicial</label>
                        <input type="number" name="Quantidade" class="form-control" value="0" required min="0" style="border-radius: 10px;">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary">Status</label>
                        <select name="Status" class="form-select" style="border-radius: 10px;">
                            <option value="Disponível">Disponível</option>
                            <option value="Em Uso">Em Uso</option>
                            <option value="Manutenção">Manutenção</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary">Material</label>
                        <input type="text" name="Material" class="form-control" placeholder="Ex: Aço" style="border-radius: 10px;">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-secondary">Categoria</label>
                        <input type="text" name="Tipo" class="form-control" placeholder="Ex: Suspensão" style="border-radius: 10px;">
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 p-3">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius: 10px;">Cancelar</button>
                <button type="submit" class="btn btn-save px-4 fw-bold shadow-sm">Salvar no Estoque</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="modalAvisos" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-danger text-white border-0">
                <h5 class="modal-title fw-bold d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Alertas Críticos
                </h5>
                <button type="button" class="btn-close btn-close-white" id="close-btn" data-bs-dismiss="modal">X</button>
            </div>
            <div class="modal-body p-0">
                <ul class="list-group list-group-flush">
                    @{
                        int avisosCount = 0;
                        foreach (DataRow row in Model.Rows)
                        {
                            int qtdAviso = Convert.ToInt32(row["quantidade"]);
                            if (qtdAviso < 5)
                            {
                                avisosCount++;
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                    <div>
                                        <strong class="text-dark d-block">@row["nome_peca"]</strong>
                                        <small class="text-muted">ID: #@row["id_peca"]</small>
                                    </div>
                                    <span class="badge bg-danger rounded-pill px-3 py-2">Restam @qtdAviso un</span>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal" style="border-radius: 10px;">Fechar</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputBusca = document.getElementById('inputBusca');
        const filtroStatus = document.getElementById('filtroStatus');
        const filtroQtd = document.getElementById('filtroQtd');
        const tbody = document.getElementById('tbodyEstoque');
        const todasAsLinhas = Array.from(tbody.getElementsByTagName('tr'));
        const paginacaoUl = document.getElementById('paginacaoUl');
        const infoPaginacao = document.getElementById('infoPaginacao');

        let itensPorPagina = 8;
        let paginaAtual = 1;
        let linhasFiltradas = [];

        function filtrarTabela() {
            const termoBusca = inputBusca.value.toLowerCase();
            const statusSelecionado = filtroStatus.value.toLowerCase();
            const qtdSelecionada = filtroQtd.value;

            linhasFiltradas = todasAsLinhas.filter(linha => {
                const textoLinha = linha.innerText.toLowerCase();
                const textoStatus = linha.cells[3].innerText.toLowerCase();
                const valorQtd = parseInt(linha.cells[2].innerText.replace(' un', '').trim());

                const correspondeBusca = textoLinha.includes(termoBusca);
                const correspondeStatus = statusSelecionado === "" || textoStatus.includes(statusSelecionado);

                let correspondeQtd = true;
                if (qtdSelecionada === "baixa") correspondeQtd = valorQtd <= 5;
                else if (qtdSelecionada === "media") correspondeQtd = valorQtd > 5 && valorQtd <= 10;
                else if (qtdSelecionada === "alta") correspondeQtd = valorQtd > 10;

                return correspondeBusca && correspondeStatus && correspondeQtd;
            });

            paginaAtual = 1;
            atualizarExibicao();
        }

        function atualizarExibicao() {
            const totalItens = linhasFiltradas.length;
            const totalPaginas = Math.ceil(totalItens / itensPorPagina);

            const inicio = (paginaAtual - 1) * itensPorPagina;
            const fim = inicio + itensPorPagina;

            todasAsLinhas.forEach(l => l.style.display = "none");

            linhasFiltradas.slice(inicio, fim).forEach(l => l.style.display = "");

            infoPaginacao.innerText = `Mostrando ${linhasFiltradas.length > 0 ? inicio + 1 : 0} a ${Math.min(fim, totalItens)} de ${totalItens} itens`;

            renderizarBotoes(totalPaginas);
        }

        function renderizarBotoes(total) {
            paginacaoUl.innerHTML = "";
            if (total <= 1) return;

            for (let i = 1; i <= total; i++) {
                const li = document.createElement('li');
                li.className = `page-item ${i === paginaAtual ? 'active' : ''}`;
                li.innerHTML = `<a class="page-link" href="javascript:void(0)">${i}</a>`;
                li.addEventListener('click', () => {
                    paginaAtual = i;
                    atualizarExibicao();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
                paginacaoUl.appendChild(li);
            }
        }

        inputBusca.addEventListener('keyup', filtrarTabela);
        filtroStatus.addEventListener('change', filtrarTabela);
        filtroQtd.addEventListener('change', filtrarTabela);

        filtrarTabela();
    });
</script>
@using System.Data
@model DataTable
@using SistemaAutoStock.ViewModels
@{
    ViewData["Title"] = "Estoque";
    Layout = "../Shared/_LayoutPROF.cshtml";
}

<div class="container mt-4" id="Container-Estoque">
    <div class="mb-3 d-flex justify-content-end gap-3">
        <button type="button" class="btn btn-outline-danger mr-2" data-bs-toggle="modal" data-bs-target="#modalAvisos">
            Avisos
        </button>
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalNovo">
            + Novo Item
        </button>
    </div>

    @if (TempData["MsgSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MsgSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">X</button>
        </div>
    }

    @if (TempData["MsgErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MsgErro"]
            <button type="button" class="btn-close text-black" data-bs-dismiss="alert" aria-label="Close">X</button>
        </div>
    }

    <table class="table border " id="Table-Estoque">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Quantidade</th>
                <th>Status</th>
                <th>Material</th>
                <th>Peso</th>
                <th>Valor</th>
                <th>Tipo</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DataRow row in Model.Rows)
            {
                <tr>
                    <td>@row["id_peca"]</td>
                    <td>@row["nome_peca"]</td>
                    <td>
                        @{
                            int qtd = Convert.ToInt32(row["quantidade"]);
                        }
                        <span class="badge @(qtd <= 5 ? "bg-danger" : qtd <= 10 ? "bg-warning" : "bg-success")">@qtd</span>
                    </td>
                    <td>@row["status"]</td>
                    <td>@row["material"]</td>
                    <td>@row["peso"] kg</td>
                    <td>@Convert.ToDecimal(row["valor"]).ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</td>
                    <td>@row["tipo"]</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#edit-@row["id_peca"]">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#del-@row["id_peca"]">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@foreach (DataRow row in Model.Rows)
{
    <div class="modal fade" id="edit-@row["id_peca"]" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-controller="Estoque" asp-action="editar" method="post" class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Editar Peça #@row["id_peca"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="IdPeca" value="@row["id_peca"]" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nome da Peça</label>
                        <input type="text" name="NomePeca" value="@row["nome_peca"]" class="form-control" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Quantidade</label>
                            <input type="number" name="Quantidade" value="@row["quantidade"]" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Status</label>
                            <select name="Status" class="form-select">
                                <option value="Disponível" selected='@(row["status"].ToString() == "Disponível")'>Disponível</option>
                                <option value="Em Uso" selected='@(row["status"].ToString() == "Em Uso")'>Em Uso</option>
                                <option value="Manutenção" selected='@(row["status"].ToString() == "Manutenção")'>Manutenção</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Material</label>
                            <input type="text" name="Material" value="@row["material"]" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tipo/Categoria</label>
                            <br />
                            <input type="text" name="Tipo" value="@row["tipo"]" class="form-control" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Peso (kg)</label>
                            <input type="number" step="0.01" name="Peso"
                                    value="@Convert.ToDecimal(row["peso"]).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                    class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Valor (R$)</label>
                            <input type="number" step="0.01" name="Valor"
                                   value="@Convert.ToDecimal(row["valor"]).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                   class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary fw-bold">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal fade" id="del-@row["id_peca"]" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-controller="Estoque" asp-action="excluir" method="post" class="modal-content border-0 shadow-lg">
                <input type="hidden" name="IdPeca" value="@row["id_peca"]" />
                <div class="modal-body text-center py-5">
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                    <h4 class="mt-3 fw-bold">Excluir "@row["nome_peca"]"?</h4>
                    <p class="text-muted">Essa operação não pode ser revertida.</p>
                </div>
                <div class="modal-footer bg-light justify-content-center border-0">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger px-4 fw-bold">Confirmar Exclusão</button>
                </div>
            </form>
        </div>
    </div>
}


<div class="modal fade" id="modalNovo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Estoque" asp-action="InserirProcessar" method="post" class="modal-content shadow-lg border-0">

            <div class="modal-header bg-success text-white py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle-fill me-2"></i> Nova Peça Automotiva
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">Nome do Item</label>
                    <input type="text" name="NomePeca" class="form-control" placeholder="Ex: Kit Amortecedor Dianteiro" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Qtd. Inicial</label>
                        <input type="number" name="Quantidade" class="form-control" value="0" required min="0" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Status</label>
                        <br />
                        <select name="Status" class="form-select">
                            <option value="Disponível">Disponível</option>
                            <option value="Em Uso">Em Uso</option>
                            <option value="Manutenção">Manutenção</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Material</label>
                        <input type="text" name="Material" class="form-control" placeholder="Ex: Aço Carbono" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Categoria/Tipo</label>
                        <input type="text" name="Tipo" class="form-control" placeholder="Ex: Suspensão" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Peso</label>
                        <div class="input-group">
                            <input type="number" step="0.01" name="Peso" class="form-control" placeholder="0.00" />
                            <span class="input-group-text">kg</span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold text-dark">Valor Unit.</label>
                        <div class="input-group">
                            <span class="input-group-text">R$</span>
                            <input type="number" step="0.01" name="Valor" class="form-control" placeholder="0.00" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-white border px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                    Salvar no Estoque
                </button>
            </div>
        </form>
    </div>
</div>
<div class="modal fade" id="modalAvisos" tabindex="-1" aria-labelledby="modalAvisosLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalAvisosLabel"><i class="bi bi-exclamation-triangle-fill"></i> Alertas de Estoque Crítico</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="list-group list-group-flush">
                    @{
                        int avisosCount = 0;
                        foreach (System.Data.DataRow row in Model.Rows)
                        {
                            int qtd = Convert.ToInt32(row["quantidade"]);
                            if (qtd < 5)
                            {
                                avisosCount++;
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@row["nome_peca"]</strong>
                                        <div class="text-muted small">ID: @row["id_peca"]</div>
                                    </div>
                                    <span class="badge bg-danger rounded-pill">Restam @qtd</span>
                                </li>
                            }
                        }

                        if (avisosCount == 0)
                        {
                            <div class="text-center text-success my-3">
                                <i class="bi bi-check-circle fs-1"></i>
                                <p class="mt-2">Seu estoque está saudável! Nenhuma peça abaixo de 5 unidades.</p>
                            </div>
                        }
                    }
                </ul>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
            </div>
        </div>
    </div>
</div>

}

<div class="container-fluid p-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">

        <div class="w-100 mb-3 mb-md-0">
            <h2 class="fw-bold mb-0 text-title"><i class="bi bi-cart3 text-novo"></i> Catálogo do Mercado</h2>
            <ol class="breadcrumb mb-0 mt-1">
                <li class="breadcrumb-item active">Produtos para futuras compras de reposição no Estoque.</li>
            </ol>
        </div>

        <div class="w-100 d-flex justify-content-md-end">
            <div class="input-group shadow-sm" style="width: 100%; max-width: 400px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="text" id="campoPesquisa" class="form-control border-start-0" placeholder="Pesquisar peça ou marca...">
            </div>
        </div>

    </div>

    <div class="row g-4 gap-2" id="gradeProdutos">
        @foreach (var item in produtosWeb)
        {
            <div class="col-12 col-md-6 col-lg-4 produto-item" style="padding-top: 20px;">
                <div class="card h-100 border-0 shadow-sm transition-hover">
                    <div class="card-header bg-light border-0 text-center py-4">
                        <i class="bi @item.Icone @item.Cor" style="font-size: 3rem;"></i>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <span class="badge bg-novo-reco">@item.Marca</span>
                            <small class="text-muted ms-2">@item.Categoria</small>
                        </div>
                        <h6 class="fw-bold">@item.Nome</h6>
                        <p class="small text-muted">@item.Aplicacao</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-5 fw-bold">R$ @item.Preco.ToString("N2")</span>
                            <button class="btn btn-sm btn-detalhe"><i class="bi bi-plus-lg"></i> Detalhes</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .transition-hover {
        transition: 0.3s;
    }

    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }
</style>

@section Scripts {
    <script>
        ///BARRA DE PESQUISA
        document.getElementById("campoPesquisa").addEventListener("keyup", function () {
            var termoDigitado = this.value.toLowerCase();
            var todosProdutos = document.querySelectorAll(".produto-item");

            todosProdutos.forEach(function (produto) {
                var textoDoProduto = produto.innerText.toLowerCase();

                // SE APARECE OU SOME CARD
                if (textoDoProduto.includes(termoDigitado)) {
                    produto.style.display = "block";
                } else {
                    produto.style.display = "none";
                }
            });
        });
    </script>
}
@model SistemaAutoStock.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Gestão";
    Layout = "~/Views/Shared/_LayoutPROF.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div style="margin-left: 260px; padding: 20px; transition: 0.3s;" id="main-dashboard-content">

    <h1 class="text-dark"><i class="bi bi-speedometer2"></i> Painel de Controle</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Visão Geral do Estoque</li>
    </ol>

    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-primary text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Total de Peças</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.TotalItens</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-tags fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-success text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Qtd Total (Unid.)</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.QtdTotal</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-box-seam fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-info text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Valor Patrimônio</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.ValorTotal</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-currency-dollar fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-danger text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Crítico (Baixo)</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.BaixoEstoque</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-exclamation-triangle fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-bar-chart-line-fill"></i> Top 5 Peças em Estoque</h6>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="meuGraficoBarras"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-pie-chart-fill"></i> Saúde do Estoque</h6>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="meuGraficoRosca"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Usamos o DOMContentLoaded para garantir que o HTML carregue antes do gráfico
        document.addEventListener("DOMContentLoaded", function () {

            // Recebendo os dados do C#
            const nomesPecas = [@Html.Raw(Model.NomesParaGrafico ?? "''")];
            const valoresPecas = [@Html.Raw(Model.ValoresParaGrafico ?? "0")];

            // 1. Desenhando Gráfico de Barras
            const ctxBar = document.getElementById('meuGraficoBarras');
            if (ctxBar) {
                new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: nomesPecas,
                        datasets: [{
                            label: 'Quantidade em Estoque',
                            data: valoresPecas,
                            backgroundColor: 'rgba(13, 110, 253, 0.8)',
                            borderColor: 'rgba(13, 110, 253, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }

            // 2. Desenhando Gráfico de Rosca
            const ctxDonut = document.getElementById('meuGraficoRosca');
            if (ctxDonut) {
                new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: ['Estoque Bom', 'Estoque Crítico'],
                        datasets: [{
                            data: [@Model.EstoqueBom, @Model.BaixoEstoque],
                            backgroundColor: ['#198754', '#dc3545'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }
        });
    </script>
}
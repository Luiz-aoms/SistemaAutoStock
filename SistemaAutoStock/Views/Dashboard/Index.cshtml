@model SistemaAutoStock.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard de Gestão";
    Layout = "~/Views/Shared/_LayoutPROF.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div style="margin-left: 260px; padding: 20px; transition: 0.3s;" id="main-dashboard-content">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="text-dark mb-0"><i class="bi bi-speedometer2"></i> Painel de Controle</h1>
            <ol class="breadcrumb mb-0 mt-1">
                <li class="breadcrumb-item active">Visão Geral do Estoque</li>
            </ol>
        </div>

        <div class="d-flex gap-2 container-botoes-exportar">
            <button class="btn btn-danger shadow-sm d-flex align-items-center fw-semibold" type="button" onclick="exportarPDF()">
                <i class="bi bi-file-earmark-pdf-fill me-2"></i> PDF
            </button>

            <button class="btn btn-success shadow-sm d-flex align-items-center fw-semibold" type="button" onclick="exportarPNG()">
                <i class="bi bi-file-image-fill me-2"></i> Imagem (PNG)
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-primary text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Total de Peças</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.TotalItens</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-tags fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-success text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Qtd Total (Unid.)</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.QtdTotal</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-box-seam fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-info text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Valor Patrimônio</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.ValorTotal</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-currency-dollar fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-danger text-white shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-uppercase mb-1">Crítico (Baixo)</div>
                            <div class="h5 mb-0 font-weight-bold">@Model.BaixoEstoque</div>
                        </div>
                        <div class="col-auto"><i class="bi bi-exclamation-triangle fs-2 text-white-50"></i></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-bar-chart-line-fill"></i> Top 5 Peças em Estoque</h6>
                    <button class="btn btn-sm btn-outline-primary" onclick="inverterOrdemBarras()" title="Inverter Ordem">
                        <i id="iconeOrdemBarras" class="bi bi-sort-down"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="meuGraficoBarras"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="bi bi-pie-chart-fill"></i> Saúde do Estoque</h6>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="meuGraficoRosca"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-success"><i class="bi bi-cash-stack"></i> Valor Patrimonial por Peça (Qtd x Preço)</h6>
                    <button class="btn btn-sm btn-outline-success" onclick="inverterOrdemValor()" title="Inverter Ordem">
                        <i id="iconeOrdemValor" class="bi bi-sort-down"></i>
                    </button>
                </div>
                <div class="card-body">
                    <div style="height: 300px;">
                        <canvas id="meuGraficoValorTotal"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        let graficoBarrasObj;
        let graficoValorTotalObj;

        let ordemCrescenteBarras = false;
        let ordemCrescenteValor = false;

        document.addEventListener("DOMContentLoaded", function () {

            const nomesPecas = [@Html.Raw(Model.NomesParaGrafico ?? "''")];
            const quantidadesPecas = [@Html.Raw(Model.ValoresParaGrafico ?? "0")];
            const valoresPatrimonio = [@Html.Raw(Model.ValoresTotaisParaGrafico ?? "0")];

            // 1. Gráfico de Barras
            const ctxBar = document.getElementById('meuGraficoBarras');
            if (ctxBar) {
                graficoBarrasObj = new Chart(ctxBar, {
                    type: 'bar',
                    data: {
                        labels: [...nomesPecas],
                        datasets: [{
                            label: 'Quantidade em Estoque',
                            data: [...quantidadesPecas],
                            backgroundColor: 'rgba(13, 110, 253, 0.8)',
                            borderColor: 'rgba(13, 110, 253, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }

            // 2. Gráfico de Rosca
            const ctxDonut = document.getElementById('meuGraficoRosca');
            if (ctxDonut) {
                new Chart(ctxDonut, {
                    type: 'doughnut',
                    data: {
                        labels: ['Estoque Bom', 'Estoque Médio', 'Estoque Crítico'],
                        datasets: [{
                            data: [@Model.EstoqueBom, @Model.EstoqueMedio, @Model.BaixoEstoque],
                            backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false
                    }
                });
            }

            // 3. Gráfico de Valor Patrimonial
            const ctxValorTotal = document.getElementById('meuGraficoValorTotal');
            if (ctxValorTotal) {
                graficoValorTotalObj = new Chart(ctxValorTotal, {
                    type: 'bar',
                    data: {
                        labels: [...nomesPecas],
                        datasets: [{
                            label: 'Valor Total (R$)',
                            data: [...valoresPatrimonio],
                            backgroundColor: 'rgba(25, 135, 84, 0.8)',
                            borderColor: 'rgba(25, 135, 84, 1)',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function (value) {
                                        return 'R$ ' + value.toLocaleString('pt-BR');
                                    }
                                }
                            }
                        }
                    }
                });
            }
        });

        // Funções de Ordenação
        function inverterOrdemBarras() {
            if (!graficoBarrasObj) return;

            let dados = graficoBarrasObj.data.datasets[0].data;
            let labels = graficoBarrasObj.data.labels;

            let lista = [];
            for (let i = 0; i < dados.length; i++) {
                lista.push({ label: labels[i], valor: dados[i] });
            }

            ordemCrescenteBarras = !ordemCrescenteBarras;
            lista.sort((a, b) => ordemCrescenteBarras ? a.valor - b.valor : b.valor - a.valor);

            for (let i = 0; i < lista.length; i++) {
                graficoBarrasObj.data.labels[i] = lista[i].label;
                graficoBarrasObj.data.datasets[0].data[i] = lista[i].valor;
            }

            let icone = document.getElementById('iconeOrdemBarras');
            if (ordemCrescenteBarras) {
                icone.classList.replace('bi-sort-down', 'bi-sort-up');
            } else {
                icone.classList.replace('bi-sort-up', 'bi-sort-down');
            }

            graficoBarrasObj.update();
        }

        function inverterOrdemValor() {
            if (!graficoValorTotalObj) return;

            let dados = graficoValorTotalObj.data.datasets[0].data;
            let labels = graficoValorTotalObj.data.labels;

            let lista = [];
            for (let i = 0; i < dados.length; i++) {
                lista.push({ label: labels[i], valor: dados[i] });
            }

            ordemCrescenteValor = !ordemCrescenteValor;
            lista.sort((a, b) => ordemCrescenteValor ? a.valor - b.valor : b.valor - a.valor);

            for (let i = 0; i < lista.length; i++) {
                graficoValorTotalObj.data.labels[i] = lista[i].label;
                graficoValorTotalObj.data.datasets[0].data[i] = lista[i].valor;
            }

            let icone = document.getElementById('iconeOrdemValor');
            if (ordemCrescenteValor) {
                icone.classList.replace('bi-sort-down', 'bi-sort-up');
            } else {
                icone.classList.replace('bi-sort-up', 'bi-sort-down');
            }

            graficoValorTotalObj.update();
        }

        // Funções de Exportação com Correção de Escopo
        function exportarPDF() {
            var elemento = document.getElementById('main-dashboard-content');
            var style = document.createElement('style');
            style.id = 'temp-print-styles';
            style.textContent = `
                        #main-dashboard-content {
                            margin-left: 0 !important;
                            width: 1300px !important;
                            max-width: none !important;
                            padding: 30px !important;
                        }
                        canvas { max-width: 100% !important; }
                        .container-botoes-exportar { display: none !important; }
                    `;
            document.head.appendChild(style);

            var opcoes = {
                margin: [0.3, 0.3, 0.3, 0.3],
                filename: 'Relatorio_Dashboard_Estoque.pdf',
                image: { type: 'jpeg', quality: 1 },
                pagebreak: { mode: 'avoid-all' },
                html2canvas: { scale: 2, useCORS: true, scrollX: 0, scrollY: 0, windowWidth: 1300 },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' }
            };

            setTimeout(function () {
                html2pdf().set(opcoes).from(elemento).save().then(function () {
                    document.head.removeChild(style);
                });
            }, 300);
        }

        function exportarPNG() {
            var elemento = document.getElementById('main-dashboard-content');
            var style = document.createElement('style');
            style.id = 'temp-print-styles';
            style.textContent = `
                        #main-dashboard-content {
                            margin-left: 0 !important;
                            width: 1300px !important;
                            max-width: none !important;
                            padding: 30px !important;
                        }
                        canvas { max-width: 100% !important; }
                        .container-botoes-exportar { display: none !important; }
                    `;
            document.head.appendChild(style);

            setTimeout(function () {
                html2canvas(elemento, { scale: 2, useCORS: true, scrollX: 0, scrollY: 0, windowWidth: 1300 }).then(function (canvas) {
                    var link = document.createElement('a');
                    link.download = 'Captura_Dashboard_Estoque.png';
                    link.href = canvas.toDataURL('image/png');
                    link.click();

                    document.head.removeChild(style);
                });
            }, 300);
        }
    </script>
}